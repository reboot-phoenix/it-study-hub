rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fields the browser may never change. They are set by the server
    // (payment webhook, XP endpoint) or by an admin in the console.
    //   plan, planActivatedAt, planExpiresAt, razorpayPaymentId, razorpayOrderId,
    //   role, isAdmin, email, joinedAt,
    //   xp, earnedXPKeys, quizBest, quizPerfect, quizImprove

    // Fields a user may write on their own document.
    function clientFields() {
      return ['name', 'username', 'college', 'dob', 'degree', 'yearOfStudy',
              'linkedin', 'github', 'bio', 'avatarEmoji', 'photoURL',
              'scores', 'badges', 'quizzesDone', 'practice'];
    }

    function validCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(clientFields().concat(['email', 'isAdmin', 'joinedAt', 'xp', 'earnedXPKeys']))
        && d.get('isAdmin', false) == false          // nobody self-promotes
        && d.get('email', request.auth.token.email) == request.auth.token.email
        && d.get('xp', 100) is number
        && d.get('xp', 100) >= 0
        && d.get('xp', 100) <= 100                   // the welcome XP, nothing more
        && d.get('earnedXPKeys', []).size() == 0;    // starts empty; only the server fills it
    }

    function validUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(clientFields())
        // xp and earnedXPKeys are not in clientFields, so any attempt to change them is rejected.
        // Quiz counter moves forward by at most 1.
        && (!('quizzesDone' in changed)
            || (after.quizzesDone >= before.get('quizzesDone', 0)
                && after.quizzesDone - before.get('quizzesDone', 0) <= 1));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
      );
    }

    match /users/{uid} {
      // NOTE: the leaderboard currently reads every user doc, so any signed-in
      // user can read all profile fields. Replace with a public leaderboard
      // projection (see task list) and then tighten this to owner or admin.
      allow read: if signedIn();

      allow create: if isOwner(uid) && validCreate();
      allow update: if isOwner(uid) && validUpdate();
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
