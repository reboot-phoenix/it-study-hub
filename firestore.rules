rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fields the browser may never change. They are set by the server
    // (payment webhook, XP endpoint) or by an admin in the console.
    //   plan, planActivatedAt, planExpiresAt, razorpayPaymentId, razorpayOrderId,
    //   role (the admin switch), email, joinedAt,
    //   xp, earnedXPKeys, quizBest, quizPerfect, quizImprove

    // Fields a user may write on their own document.
    function clientFields() {
      return ['name', 'username', 'college', 'dob', 'degree', 'yearOfStudy',
              'linkedin', 'github', 'bio', 'avatarEmoji', 'photoURL',
              'scores', 'badges', 'quizzesDone', 'practice'];
    }

    // Text a user writes about themselves is shown to other people (leaderboard) and to admins,
    // so keep it small and plain. Rendering code also escapes everything; this is a second layer.
    function okText(v, max) {
      return v == null || v is number || (v is string && v.size() <= max);
    }

    function okPhoto(v) {
      return v == null || (v is string && v.size() <= 500 && v.matches('https://[^ "<>]*'));
    }

    function okProfileText(d, keys) {
      return (!('name' in keys) || okText(d.name, 80))
        && (!('username' in keys) || okText(d.username, 40))
        && (!('college' in keys) || okText(d.college, 120))
        && (!('degree' in keys) || okText(d.degree, 80))
        && (!('yearOfStudy' in keys) || okText(d.yearOfStudy, 20))
        && (!('dob' in keys) || okText(d.dob, 20))
        && (!('linkedin' in keys) || okText(d.linkedin, 300))
        && (!('github' in keys) || okText(d.github, 300))
        && (!('bio' in keys) || okText(d.bio, 600))
        && (!('avatarEmoji' in keys) || okText(d.avatarEmoji, 16))
        && (!('photoURL' in keys) || okPhoto(d.photoURL))
        && (!('scores' in keys) || d.scores is map)
        && (!('badges' in keys) || (d.badges is list && d.badges.size() <= 100));
    }

    function validCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(clientFields().concat(['email', 'joinedAt', 'xp', 'earnedXPKeys']))   // no role, no isAdmin
        && d.get('email', request.auth.token.email) == request.auth.token.email
        && d.get('xp', 100) is number
        && d.get('xp', 100) >= 0
        && d.get('xp', 100) <= 100                   // the welcome XP, nothing more
        && d.get('earnedXPKeys', []).size() == 0     // starts empty; only the server fills it
        && okProfileText(d, d.keys().toSet());
    }

    function validUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(clientFields())
        && okProfileText(after, changed)
        // xp and earnedXPKeys are not in clientFields, so any attempt to change them is rejected.
        // Quiz counter moves forward by at most 1.
        && (!('quizzesDone' in changed)
            || (after.quizzesDone >= before.get('quizzesDone', 0)
                && after.quizzesDone - before.get('quizzesDone', 0) <= 1));
    }

    // The single admin switch: users/{uid}.role == 'admin'. Browsers cannot write `role`
    // (it is not in clientFields), so it is set only in the Firebase console or with scripts/grant-admin.mjs.
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Private profile: only its owner and admins can read it. Other students only ever see
    // the public copy in leaderboard/ (name, xp, photo, solved count), which the Worker writes.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validCreate();
      allow update: if isOwner(uid) && validUpdate();
      allow delete: if false;
    }

    match /leaderboard/{uid} {
      allow read: if signedIn();     // lists and count() queries
      allow write: if false;         // only the Worker (service account) writes here
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
